NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

R2_ACCOUNT_ID=
R2_BUCKET_NAME=project-octopus-dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_KEY=
CRON_SECRET=

# Shared bearer token for server-to-server KSeF / ERP / API ingestion.
# Leave empty to keep the external integration endpoint disabled.
OCTOPUS_INTEGRATION_TOKEN=

# Optional vendor-neutral malware scanner. The endpoint receives the raw file
# in a POST request and returns JSON: { "clean": boolean, "engine"?: string,
# "scanId"?: string, "threat"?: string }.
OCTOPUS_MALWARE_SCAN_URL=
OCTOPUS_MALWARE_SCAN_TOKEN=

# true = do not analyse or download a file when the scanner is unavailable.
# Keep false only for a controlled rollout; an infected verdict always blocks.
OCTOPUS_REQUIRE_MALWARE_SCAN=false
